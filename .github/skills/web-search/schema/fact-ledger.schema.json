{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/junwoojeong100/github-copilot-augment-kit/main/.github/skills/web-search/schema/fact-ledger.schema.json",
  "title": "Web Search Fact Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkedAt", "facts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "checkedAt": {"type": "string", "format": "date-time"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ledgerEntry"}
    },
    "excludedSources": {
      "type": "array",
      "items": {"$ref": "#/$defs/excludedSource"}
    }
  },
  "$defs": {
    "dateOrUnknown": {
      "oneOf": [
        {"type": "string", "format": "date"},
        {"const": "확인 불가"}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "publisher",
        "publishedOrUpdated",
        "accessed"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "publisher": {"type": "string", "minLength": 1},
        "publishedOrUpdated": {"$ref": "#/$defs/dateOrUnknown"},
        "accessed": {"type": "string", "format": "date"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "legacySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "legacyProvenance": {
      "required": ["source", "publisher", "publishedOrUpdated", "accessed"]
    },
    "ledgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "claim",
        "evidence",
        "scopeOrStatus",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "type": {"enum": ["Fact", "Inference", "Assumption"]},
        "claim": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "basisIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        },
        "assumptionOwner": {"type": "string", "minLength": 1},
        "validationNeeded": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/legacySource"},
        "publisher": {"type": "string", "minLength": 1},
        "publishedOrUpdated": {"$ref": "#/$defs/dateOrUnknown"},
        "accessed": {"type": "string", "format": "date"},
        "scopeOrStatus": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["High", "Medium", "Low"]},
        "status": {
          "enum": ["Accepted", "Contested", "Rejected", "Unresolved"]
        },
        "decisionRationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"required": ["source"]},
              {"required": ["publisher"]},
              {"required": ["publishedOrUpdated"]},
              {"required": ["accessed"]}
            ]
          },
          "then": {
            "required": [
              "source",
              "publisher",
              "publishedOrUpdated",
              "accessed"
            ]
          }
        },
        {
          "not": {
            "anyOf": [
              {"required": ["sources", "source"]},
              {"required": ["sources", "publisher"]},
              {"required": ["sources", "publishedOrUpdated"]},
              {"required": ["sources", "accessed"]}
            ]
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "Fact"}},
            "required": ["type"]
          },
          "then": {
            "anyOf": [
              {"required": ["sources"]},
              {"$ref": "#/$defs/legacyProvenance"}
            ]
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "Inference"}},
            "required": ["type"]
          },
          "then": {
            "anyOf": [
              {"required": ["basisIds"]},
              {"required": ["sources"]},
              {"$ref": "#/$defs/legacyProvenance"}
            ]
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "Assumption"}},
            "required": ["type"]
          },
          "then": {
            "required": ["assumptionOwner", "validationNeeded"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["Contested", "Rejected", "Unresolved"]
              }
            },
            "required": ["status"]
          },
          "then": {"required": ["decisionRationale"]}
        }
      ]
    },
    "excludedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "reason", "accessed"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "reason": {"type": "string", "minLength": 1},
        "accessed": {"type": "string", "format": "date"}
      }
    }
  }
}
